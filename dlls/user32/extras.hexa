let defaultDC DC = DC()

@dllExport('GetDC')
fun getDC(hWnd HWnd?) HDc {
	// TODO Retrieve device context
	tofitaDebugLog("GetDC called with hWnd %8".utf16(), hWnd as! UInt64)
	let window = handleToWindow(hWnd)
	if window == null {
		return defaultDC as! HDc
	}
	return window.dc.ref as! HDc
}


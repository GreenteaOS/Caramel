@dllExport('SetBrushOrgEx')
fun setBrushOrgEx(hdc HDc, x Int32, y Int32, lppt Point?) Bool32 {
	tofitaDebugLog("SetBrushOrgEx called with hdc %8".utf16(), hdc as! UInt64)
	tofitaDebugLog("> x %d y %d".utf16(), x as! UInt64, y as! UInt64)
	tofitaDebugLog("> lppt %8".utf16(), lppt as! UInt64)
	// TODO Set brush origin, store old in lppt
	let dc = hdc as! DC
	if dc == null {
		tofitaDebugLog("> Invalid DC".utf16())
		return Bool32.False
	}

	if let lppt = lppt {
		lppt.x = dc.brushOrgX
		lppt.y = dc.brushOrgY
	}

	dc.brushOrgX = x
	dc.brushOrgY = y
	return Bool32.True
}

@dllExport('SetTextColor')
fun setTextColor(hdc HDc, color COLORREF) COLORREF {
	tofitaDebugLog("SetTextColor called with hdc %8 color %u".utf16(), hdc as! UInt64, color as! UInt64)

	let dc = hdc as! DC
	if dc == null {
		tofitaDebugLog("> Invalid DC".utf16())
		return 0
	}

	let prevColor = dc.textColor
	dc.textColor = color
	return prevColor
}


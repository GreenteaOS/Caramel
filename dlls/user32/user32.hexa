@struct
class MonitorInfo {
	var cbSize UInt32
	let rcMonitor ByValue<Rect>
	let rcWork ByValue<Rect>
	let dwFlags UInt32
}

@struct
class LogFontW {
	let lfHeight Int32
	let lfWidth Int32
	let lfEscapement Int32
	let lfOrientation Int32
	let lfWeight Int32
	let lfItalic UInt8
	let lfUnderline UInt8
	let lfStrikeOut UInt8
	let lfCharSet UInt8
	let lfOutPrecision UInt8
	let lfClipPrecision UInt8
	let lfQuality UInt8
	let lfPitchAndFamily UInt8
	// TODO LF_FACESIZE = 32
	// TODO let
	var lfFaceName ArrayByValue<ClangWideChar, 32>
}

@struct
class NonClientMetricsW {
	var cbSize UInt32
	let iBorderWidth Int32
	let iScrollWidth Int32
	let iScrollHeight Int32
	let iCaptionWidth Int32
	let iCaptionHeight Int32
	let lfCaptionFont ByValue<LogFontW>
	let iSmCaptionWidth Int32
	let iSmCaptionHeight Int32
	let lfSmCaptionFont ByValue<LogFontW>
	let iMenuWidth Int32
	let iMenuHeight Int32
	let lfMenuFont ByValue<LogFontW>
	let lfStatusFont ByValue<LogFontW>
	let lfMessageFont ByValue<LogFontW>
	let iPaddedBorderWidth Int32
}

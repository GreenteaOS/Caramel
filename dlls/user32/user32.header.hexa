@inline fun lstrlenW(str ConstArrayPointer<ClangWideChar>) Int {
	var i = 0
	while str[i] != 0 as! ClangWideChar {
		i++
	}

	tofitaDebugLog("lstrlenW %S %d".utf16(), str as! UInt64, i as! UInt64)
	return i
}

// TODO handle `#` variation
fun isAtom(value UInt64) Bool {
	tofitaDebugLog("isAtom called".utf16())
	if value > 0xBFFF {
		return false
	}

	return true
}

